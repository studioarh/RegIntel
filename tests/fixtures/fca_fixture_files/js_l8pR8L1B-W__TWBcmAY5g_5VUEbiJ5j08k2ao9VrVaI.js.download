(function($){Drupal.behaviors.FCAFunnelback={attach:function attach(context){var funnelbackCollection=drupalSettings.fcaFunnelback.funnelbackCollection;$('input.funnelback-query').fbcompletion({'enabled':'enabled','collection':funnelbackCollection,'program':'//fcauk-search.funnelback.squiz.cloud/s/suggest.json','alpha':'.5','show':'10','sort':'0','length':'3','delay':'0'});$('.search-item__clickthrough').click(function(){var clickTrackingUrl=$(this).data('click-track');if(clickTrackingUrl.length!=0)$.get(clickTrackingUrl);});}};})(jQuery);;
(function($){Drupal.behaviors.FCAPopup={attach:function(context){if(drupalSettings.hasOwnProperty('disable_all_popups')&&drupalSettings.disable_all_popups==1)return true;Drupal.behaviors.FCAPopup.cookies=[];var popupText=this.createModalText();if(popupText){this.popup=this.showModal(popupText);$(window).on('load',function(){Drupal.behaviors.FCAPopup.popup.modal('show');});}},createModalText:function(){var popupText='';var i;if(drupalSettings.hasOwnProperty('global_popup')&&drupalSettings.global_popup.popup_global_enabled)if(!Drupal.behaviors.FCAPopup.checkCookie('fca_popup_global')){popupText+='<div class="popup-content clearfix modal-bg--FFC72C"><h3 class="global-popup_title">'+drupalSettings.global_popup.popup_global_title+'</h3>';popupText+='<div class="global-popup_text">';popupText+=drupalSettings.global_popup.popup_global_text;popupText+='</div></div>';Drupal.behaviors.FCAPopup.cookies.push('fca_popup_global');}if(drupalSettings.hasOwnProperty('url_popup')&&drupalSettings.url_popup.length)for(i=0;i<drupalSettings.url_popup.length;i++)if(!Drupal.behaviors.FCAPopup.checkCookie('fca_popup_'+drupalSettings.url_popup[i]['cookie'])){popupText+='<div class="popup-content clearfix modal-bg--light-grey"><h3 class="global-popup_title">'+drupalSettings.url_popup[i]['title']+'</h3>';popupText+='<div class="global-popup_text">';popupText+=drupalSettings.url_popup[i].text.value;popupText+='</div></div>';Drupal.behaviors.FCAPopup.cookies.push('fca_popup_'+drupalSettings.url_popup[i]['cookie']);}return popupText;},showModal:function(popupText){var popup='<div class="modal fade" tabindex="-1" role="dialog">';popup+='<div class="modal-dialog" role="document"><div class="modal-content"><div class="modal-header">';popup+='<button type="button" class="btn" data-dismiss="modal" aria-label="Close"></button>';popup+='</div>';popup+=popupText;popup+='<div class="modal-footer">';popup+='<button type="button" class="btn js-fca-popup-accept content-popup-accept popup-accept">'+drupalSett